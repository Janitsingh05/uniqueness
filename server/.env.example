# Copy to .env and fill in. Never commit .env — it holds your API key.

# ---- Speech-to-text ----------------------------------------------------
# Two options — pick one by setting STT_PROVIDER.
#
# openai (default) — https://platform.openai.com/api-keys
#   whisper-1, ~$0.006/min. Needs billing set up.
OPENAI_API_KEY=
#
# groq — https://console.groq.com/keys — free tier, no card needed.
#   Same API shape as OpenAI (word timestamps included), just a
#   different key and this server routes to Groq automatically.
# STT_PROVIDER=groq
# GROQ_API_KEY=
#
# STT_MODEL= leave unset to use each provider's sensible default
#   (whisper-1 for openai, whisper-large-v3 for groq).
#
# GROQ_API_KEY (above) also powers an optional AI polish pass on
# auto-generated Hinglish captions (lib/spellcheck.js) — fixes spellings
# the rule-based transliterator gets phonetically-correct-but-unnatural
# ("laraki" -> "ladki"). Works independently of STT_PROVIDER; set
# GROQ_API_KEY even if STT_PROVIDER=openai to get this. No key = this
# pass is silently skipped, captions still work, just unpolished.
# GROQ_CHAT_MODEL= leave unset for the current default (see config.js).

# ---- Payments ------------------------------------------------------------
# https://dashboard.razorpay.com/app/keys
# keyId is safe client-side; keySecret must only ever live here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Settings -> Webhooks -> add this server's /api/payments/webhook
# URL, pick a secret yourself when you add it (Razorpay doesn't generate one
# for you), paste the same value here.
RAZORPAY_WEBHOOK_SECRET=

# ---- Accounts (server-side crediting) -----------------------------------
# Firebase Console -> Project settings -> Service accounts -> Generate new
# private key. Paste the whole downloaded JSON on one line. Only needed for
# webhook-driven crediting (subscription renewals) — the browser's own
# checkout flow works without this.
FIREBASE_SERVICE_ACCOUNT=

# ---- Server ------------------------------------------------------------
PORT=8080
# Origins allowed to call this API. Use * only while developing.
# Live example: https://janitsingh05.github.io
ALLOWED_ORIGINS=*

# Largest clip accepted, in MB.
MAX_UPLOAD_MB=500
# Finished renders are deleted after this many minutes.
RETENTION_MINUTES=60

# ---- FFmpeg ------------------------------------------------------------
# Leave unset to use whatever is on PATH.
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/ffmpeg/bin/ffprobe.exe
# ultrafast | veryfast | medium — faster preset means a bigger file.
FFMPEG_PRESET=ultrafast
# Lower CRF is better quality and a bigger file. 18-24 is a sane range.
FFMPEG_CRF=20
